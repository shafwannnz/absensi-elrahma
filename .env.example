APP_NAME="Absensi STIKOM El Rahma"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://absensi-elrahma.test

# Zona waktu WIB -> dipakai untuk semua perhitungan jam absensi
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database MySQL bawaan Laragon (user root tanpa password)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensi_elrahma
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Pengaturan absensi (opsional, ada nilai default di config/absensi.php) ---
# Ambang kemiripan wajah. Makin KECIL = makin ketat. Rentang wajar 0.4 - 0.6
FACE_MATCH_THRESHOLD=0.5
# Akurasi GPS terburuk yang masih diterima (meter)
MAX_GPS_ACCURACY_M=200

VITE_APP_NAME="${APP_NAME}"
